{
  "entities": {
    "AllowedUsers": {
      "title": "AllowedUsers",
      "description": "Authorized emails permitted to enter the application with roles (admin or viewer)",
      "type": "object",
      "properties": {
        "emails": {
          "type": "array",
          "description": "List of authorized email addresses in lowercase"
        },
        "admins": {
          "type": "array",
          "description": "List of admin email addresses in lowercase"
        },
        "roles": {
          "type": "object",
          "description": "Mapping from lowercase email to role (admin or viewer)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email of user who made the update"
        }
      },
      "required": ["emails"]
    },
    "SettingConfig": {
      "title": "SettingConfig",
      "description": "Application packing charge, inbound freight, and marketplace customer-return percentages",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Document type identifier 'config'"
        },
        "packing_per_dispatched_unit": {
          "type": "number",
          "description": "Packing charge per dispatched unit in INR (default 6)"
        },
        "inbound_freight_per_purchased_unit": {
          "type": "number",
          "description": "Inbound freight per purchased unit in INR (default 5)"
        },
        "flipkart_not_sellable_pct": {
          "type": "number",
          "description": "Customer-return not-sellable percentage for Flipkart (default 5%)"
        },
        "amazon_not_sellable_pct": {
          "type": "number",
          "description": "Customer-return not-sellable percentage for Amazon (default 5%)"
        },
        "meesho_not_sellable_pct": {
          "type": "number",
          "description": "Customer-return not-sellable percentage for Meesho (default 5%)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "User email who updated the settings"
        }
      },
      "required": ["packing_per_dispatched_unit", "inbound_freight_per_purchased_unit", "flipkart_not_sellable_pct", "amazon_not_sellable_pct", "meesho_not_sellable_pct"]
    },
    "SettingAudit": {
      "title": "SettingAudit",
      "description": "Audit log record for changes made to application settings",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Document type identifier 'audit'"
        },
        "setting_key": {
          "type": "string",
          "description": "Name or key of the setting modified"
        },
        "old_value": {
          "type": "string",
          "description": "Old value before change"
        },
        "new_value": {
          "type": "string",
          "description": "New value after change"
        },
        "user_email": {
          "type": "string",
          "description": "Email of user who made the change"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the change"
        }
      },
      "required": ["setting_key", "old_value", "new_value", "user_email", "timestamp"]
    },
    "CostMasterItem": {
      "title": "CostMasterItem",
      "description": "Cost master record with sku_code, sku_name, weight_grams, mfg_cost, active, and effective_from",
      "type": "object",
      "properties": {
        "sku_code": {
          "type": "string",
          "description": "Unique SKU code identifier",
          "maxLength": 100
        },
        "sku_name": {
          "type": "string",
          "description": "Product display name",
          "maxLength": 500
        },
        "weight_grams": {
          "type": "number",
          "description": "Product weight in grams"
        },
        "mfg_cost": {
          "type": "number",
          "description": "Manufacturing or base procurement cost in INR"
        },
        "active": {
          "type": "boolean",
          "description": "Active status of SKU (soft delete when false)"
        },
        "effective_from": {
          "type": "string",
          "description": "Effective date string (YYYY-MM-DD)"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "createdBy": {
          "type": "string",
          "description": "User who created this cost record"
        }
      },
      "required": ["sku_code", "sku_name", "weight_grams", "mfg_cost", "active", "effective_from"]
    },
    "OpeningStockItem": {
      "title": "OpeningStockItem",
      "description": "Per SKU baseline opening stock quantity and manufacturing rate as of 2026-04-01",
      "type": "object",
      "properties": {
        "sku_code": {
          "type": "string",
          "description": "Unique master SKU code"
        },
        "qty": {
          "type": "number",
          "description": "Opening quantity on hand"
        },
        "mfg_rate": {
          "type": "number",
          "description": "Manufacturing or base unit rate in INR"
        },
        "landed_rate": {
          "type": "number",
          "description": "Computed standard landed rate (mfg_rate + inbound_freight)"
        },
        "effective_from": {
          "type": "string",
          "description": "Effective date of opening stock baseline (default 2026-04-01)"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "createdBy": {
          "type": "string",
          "description": "Email of user who created this opening stock row"
        }
      },
      "required": ["sku_code", "qty", "mfg_rate", "effective_from"]
    },
    "PurchaseItem": {
      "title": "PurchaseItem",
      "description": "Procurement purchase inward record with landed rate, bill number, supplier, and void flag",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Purchase / invoice date (YYYY-MM-DD)"
        },
        "sku_code": {
          "type": "string",
          "description": "Master SKU code"
        },
        "qty": {
          "type": "number",
          "description": "Purchased quantity"
        },
        "mfg_rate": {
          "type": "number",
          "description": "Unit manufacturing or purchase rate in INR"
        },
        "landed_rate": {
          "type": "number",
          "description": "Unit landed rate (mfg_rate + inbound_freight at time of entry)"
        },
        "bill_no": {
          "type": "string",
          "description": "Supplier invoice or bill number"
        },
        "supplier": {
          "type": "string",
          "description": "Supplier or vendor name"
        },
        "upload_id": {
          "type": "string",
          "description": "Reference ID to purchase_uploads batch or 'manual'"
        },
        "void": {
          "type": "boolean",
          "description": "Soft void flag: rows are never deleted, void rows excluded from cost averages"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "createdBy": {
          "type": "string",
          "description": "Email of user who recorded this purchase"
        }
      },
      "required": ["date", "sku_code", "qty", "mfg_rate", "landed_rate", "bill_no", "upload_id", "void"]
    },
    "PurchaseUpload": {
      "title": "PurchaseUpload",
      "description": "Audit record of purchase spreadsheet file uploads",
      "type": "object",
      "properties": {
        "file_name": {
          "type": "string",
          "description": "Original name of the uploaded file"
        },
        "uploaded_at": {
          "type": "string",
          "description": "ISO timestamp of upload"
        },
        "user": {
          "type": "string",
          "description": "User email who performed the upload"
        },
        "accepted_count": {
          "type": "number",
          "description": "Count of valid purchase rows imported"
        },
        "rejected_count": {
          "type": "number",
          "description": "Count of invalid rows rejected"
        },
        "skipped_duplicates_count": {
          "type": "number",
          "description": "Count of duplicate rows skipped"
        },
        "total_rows": {
          "type": "number",
          "description": "Total rows processed in file"
        }
      },
      "required": ["file_name", "uploaded_at", "user", "accepted_count", "rejected_count", "skipped_duplicates_count"]
    },
    "SkuAlias": {
      "title": "SkuAlias",
      "description": "Marketplace SKU alias mapped to internal master SKU code",
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "description": "Cleaned marketplace SKU alias (doc ID)"
        },
        "master_sku": {
          "type": "string",
          "description": "Matched master SKU code from cost_master"
        },
        "source": {
          "type": "string",
          "description": "Mapping source, e.g. bundled_v2 or manual"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "createdBy": {
          "type": "string",
          "description": "Email of user who created the alias"
        }
      },
      "required": ["alias", "master_sku", "source"]
    },
    "FkOrderItem": {
      "title": "FkOrderItem",
      "description": "Flipkart parsed order item record",
      "type": "object",
      "properties": {
        "orderItemId": { "type": "string" },
        "orderId": { "type": "string" },
        "orderDate": { "type": "string" },
        "status": { "type": "string" },
        "sku": { "type": "string" },
        "qty": { "type": "number" },
        "upload_id": { "type": "string" }
      },
      "required": ["orderItemId", "orderDate", "sku", "qty", "status", "upload_id"]
    },
    "FkReturn": {
      "title": "FkReturn",
      "description": "Flipkart parsed return record",
      "type": "object",
      "properties": {
        "returnId": { "type": "string" },
        "orderItemId": { "type": "string" },
        "returnType": { "type": "string" },
        "returnStatus": { "type": "string" },
        "sku": { "type": "string" },
        "qty": { "type": "number" },
        "upload_id": { "type": "string" }
      },
      "required": ["returnId", "orderItemId", "returnType", "returnStatus", "sku", "qty", "upload_id"]
    },
    "FkSettlementRow": {
      "title": "FkSettlementRow",
      "description": "Flipkart parsed settled order row with fee breakdowns",
      "type": "object",
      "properties": {
        "neftId": { "type": "string" },
        "orderItemId": { "type": "string" },
        "bankSettlement": { "type": "number" },
        "saleAmount": { "type": "number" },
        "marketplaceFee": { "type": "number" },
        "sellerSku": { "type": "string" },
        "qty": { "type": "number" },
        "upload_id": { "type": "string" }
      },
      "required": ["neftId", "orderItemId", "bankSettlement", "sellerSku", "qty", "upload_id"]
    },
    "FkAdjustment": {
      "title": "FkAdjustment",
      "description": "Flipkart adjustment record from Ads, Fines, Storage, etc.",
      "type": "object",
      "properties": {
        "sheet": { "type": "string" },
        "neftId": { "type": "string" },
        "amount": { "type": "number" },
        "upload_id": { "type": "string" }
      },
      "required": ["sheet", "neftId", "amount", "upload_id"]
    },
    "FkBatch": {
      "title": "FkBatch",
      "description": "Flipkart payout batch grouped by NEFT ID",
      "type": "object",
      "properties": {
        "neftId": { "type": "string" },
        "paymentDate": { "type": "string" },
        "orderRowsCount": { "type": "number" },
        "orderRowsTotal": { "type": "number" },
        "adjustmentsTotal": { "type": "number" },
        "expectedBankAmount": { "type": "number" },
        "upload_id": { "type": "string" }
      },
      "required": ["neftId", "paymentDate", "orderRowsCount", "orderRowsTotal", "expectedBankAmount", "upload_id"]
    },
    "FkReportSummary": {
      "title": "FkReportSummary",
      "description": "Summary metadata of Flipkart settled report period",
      "type": "object",
      "properties": {
        "periodStart": { "type": "string" },
        "periodEnd": { "type": "string" },
        "ordersTotal": { "type": "number" },
        "adjustmentsTotal": { "type": "number" },
        "netBankSettlement": { "type": "number" },
        "upload_id": { "type": "string" }
      },
      "required": ["periodStart", "periodEnd", "netBankSettlement", "upload_id"]
    },
    "FkUpload": {
      "title": "FkUpload",
      "description": "Audit record of Flipkart report uploads",
      "type": "object",
      "properties": {
        "report_type": { "type": "string" },
        "month": { "type": "string" },
        "file_name": { "type": "string" },
        "file_hash": { "type": "string" },
        "uploaded_at": { "type": "string" },
        "user": { "type": "string" },
        "record_counts": { "type": "object" }
      },
      "required": ["report_type", "month", "file_name", "file_hash", "uploaded_at", "user", "record_counts"]
    }
  },
  "firestore": {
    "/allowedUsers/{docId}": {
      "schema": "AllowedUsers",
      "description": "List of authorized user emails and roles (admin or viewer)"
    },
    "/settings/{docId}": {
      "schema": "SettingConfig",
      "description": "Application settings configuration and create-only audit log entries"
    },
    "/cost_master/{itemId}": {
      "schema": "CostMasterItem",
      "description": "Effective-dated cost master rows with weight_grams, mfg_cost, and active status"
    },
    "/opening_stock/{docId}": {
      "schema": "OpeningStockItem",
      "description": "Per-SKU create-only opening stock records with effective_from"
    },
    "/purchases/{docId}": {
      "schema": "PurchaseItem",
      "description": "Purchase line items with landed_rate, upload_id, and admin void status"
    },
    "/purchase_uploads/{docId}": {
      "schema": "PurchaseUpload",
      "description": "Audit log of purchase spreadsheet file uploads with accepted, rejected, and skipped counts"
    },
    "/sku_aliases/{docId}": {
      "schema": "SkuAlias",
      "description": "Marketplace SKU aliases mapped to internal master SKU codes"
    },
    "/fk_order_items/{docId}": {
      "schema": "FkOrderItem",
      "description": "Flipkart order items with status and quantities"
    },
    "/fk_returns/{docId}": {
      "schema": "FkReturn",
      "description": "Flipkart returns with return types and tracking IDs"
    },
    "/fk_settlement_rows/{docId}": {
      "schema": "FkSettlementRow",
      "description": "Flipkart settled order items with financial breakdowns"
    },
    "/fk_adjustments/{docId}": {
      "schema": "FkAdjustment",
      "description": "Flipkart adjustments across Ads, Fines, Storage, etc."
    },
    "/fk_batches/{docId}": {
      "schema": "FkBatch",
      "description": "Flipkart payout batch reconciliation by NEFT ID"
    },
    "/fk_report_summaries/{docId}": {
      "schema": "FkReportSummary",
      "description": "Flipkart settled report summary metadata"
    },
    "/fk_uploads/{docId}": {
      "schema": "FkUpload",
      "description": "Create-only audit log of Flipkart file uploads"
    }
  }
}

