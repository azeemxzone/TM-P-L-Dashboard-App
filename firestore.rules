rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && userEmail() == 'mak44641@gmail.com';
    }

    function hasAllowedDoc() {
      return exists(/databases/$(database)/documents/allowedUsers/default);
    }

    function allowedDocData() {
      return get(/databases/$(database)/documents/allowedUsers/default).data;
    }

    function isAllowedUser() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (hasAllowedDoc() && userEmail() in allowedDocData().emails)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (hasAllowedDoc() && (
          ('admins' in allowedDocData() && userEmail() in allowedDocData().admins) ||
          ('roles' in allowedDocData() && allowedDocData().roles[userEmail()] == 'admin')
        ))
      );
    }

    // Allowed Users collection
    // Viewers and signed-in users can read their authorization status.
    // Only admins can write. Non-members cannot self-register.
    match /allowedUsers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && (
        isBootstrapAdmin() ||
        (resource != null && userEmail() in resource.data.emails)
      );
    }

    // Settings collection
    // Read: Allowed users (viewers and admins)
    // Write: Admin only
    // Audit log records are create-only (no update, no delete)
    match /settings/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && (
        !docId.matches('^audit_.*') &&
        (!('type' in resource.data) || resource.data.type != 'audit')
      );
    }

    // Cost Master collection
    // Read: Allowed users (viewers and admins)
    // Write: Admin only (viewers are read-only)
    match /cost_master/{itemId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin();
    }

    // SKU Variants collection (replaces marketplace mapping)
    // Read: Allowed users (viewers and admins)
    // Write: Admin only (viewers are read-only)
    match /sku_variants/{variantId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin();
    }

    // Backward compatibility for legacy sku_mappings path
    match /sku_mappings/{mappingId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin();
    }
  }
}
