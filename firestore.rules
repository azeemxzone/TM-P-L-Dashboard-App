rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Normalized lowercase user email
    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isBootstrapAdmin() {
      return isSignedIn() && userEmail() == 'mak44641@gmail.com';
    }

    function hasAllowedDoc() {
      return exists(/databases/$(database)/documents/allowedUsers/default);
    }

    function allowedDocData() {
      return get(/databases/$(database)/documents/allowedUsers/default).data;
    }

    function isAllowedUser() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (hasAllowedDoc() && userEmail() in allowedDocData().emails)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (hasAllowedDoc() && (
          ('admins' in allowedDocData() && userEmail() in allowedDocData().admins) ||
          ('roles' in allowedDocData() && allowedDocData().roles[userEmail()] == 'admin')
        ))
      );
    }

    // Allowed Users collection
    // Read only if isAllowedUser() or the bootstrap admin.
    // Write only by admins.
    match /allowedUsers/{docId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin() && (
        isBootstrapAdmin() ||
        (resource != null && userEmail() in resource.data.emails)
      );
    }

    // Settings collection
    // Read: Allowed users (viewers and admins)
    // Write: Admin only
    // Audit log records are create-only (no update, no delete)
    match /settings/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && (
        !docId.matches('^audit_.*') &&
        (!('type' in resource.data) || resource.data.type != 'audit')
      );
    }

    // Cost Master collection
    // Create allowed for admins.
    // Update allowed only if the only changed field is `active`.
    // Delete is denied.
    match /cost_master/{itemId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }

    // Opening Stock collection
    // Create-only with effective_from. Latest row per SKU applies.
    // Read: Allowed users (viewers and admins)
    // Write: Admin only, create-only (no update, no delete)
    match /opening_stock/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Purchases collection
    // Read: Allowed users
    // Create: Admin only
    // Update: Admin only, and ONLY if the only changed field is `void`
    // Delete: denied (rows are never deleted: admin can mark void)
    match /purchases/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['void']);
      allow delete: if false;
    }

    // Purchase Uploads log collection
    // Read: Allowed users
    // Create: Admin only (create-only audit log)
    // Update, Delete: denied
    match /purchase_uploads/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // SKU Aliases collection (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /sku_aliases/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Order Items (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /fk_order_items/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Returns (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /fk_returns/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Settlement Rows (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /fk_settlement_rows/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Adjustments (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /fk_adjustments/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Batches (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /fk_batches/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Report Summaries (Stage 2b)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /fk_report_summaries/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Flipkart Uploads audit log (Stage 2b & 2c)
    // Read: Allowed users
    // Create: Admin only (create-only)
    // Update, Delete: denied
    match /fk_uploads/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Bank Statement Credits (Stage 2c)
    // Read: Allowed users
    // Create & Update: Admin only
    // Delete: denied
    match /bank_credits/{docId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}

